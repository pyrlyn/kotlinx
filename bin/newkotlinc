#!/bin/bash
# KotlinX compiler launcher: builds compiler/build/newkotlinc.kexe on first use, then runs it.
# Usage: bin/newkotlinc Main.kt -o main && ./main
root="$(cd "$(dirname "$0")/.." && pwd)"
exe="$root/compiler/build/newkotlinc.kexe"
[ -x "$exe" ] || "$root/compiler/build.sh" >&2 || exit 1
export NEWKOTLIN_RUNTIME="${NEWKOTLIN_RUNTIME:-$root/compiler/runtime/runtime.c}"
# Vendored C GC metadata/sources (caps, kxgc.h, optional --gc-runtime=c).
export NEWKOTLIN_GC_DIR="${NEWKOTLIN_GC_DIR:-$root/native/gc/c}"
export NEWKOTLIN_GC_ZIG_LIB_DIR="${NEWKOTLIN_GC_ZIG_LIB_DIR:-$root/native/gc/zig/zig-out/lib}"
# Default collector backend is Zig (experimental). Set NEWKOTLIN_GC_RUNTIME=c for the C collectors.
export NEWKOTLIN_GC_RUNTIME="${NEWKOTLIN_GC_RUNTIME:-zig}"

# Ensure Zig collector archives exist when using the Zig backend (cached by zig build).
ensure_zig_gc_libs() {
  case "${NEWKOTLIN_GC_RUNTIME}" in
    c|C) return 0 ;;
  esac
  # Skip if user already passes --gc-runtime=c on the CLI (env still zig by default).
  for a in "$@"; do
    case "$a" in
      --gc-runtime=c|--gc-runtime=C) return 0 ;;
      --gc-runtime) return 0 ;; # next arg checked loosely; rebuild is cheap if zig
    esac
  done
  local need=0 g
  for g in epoch perceus incremental rc; do
    [ -f "$NEWKOTLIN_GC_ZIG_LIB_DIR/libgc-$g.a" ] || need=1
  done
  [ "$need" = 0 ] && return 0
  local zigbin="${ZIG:-}"
  if [ -z "$zigbin" ]; then
    if command -v zig >/dev/null 2>&1; then zigbin=$(command -v zig); else
      echo "error: Zig 0.17.1 required to build GC libs (NEWKOTLIN_GC_RUNTIME=zig). Set ZIG=/path/to/zig or install official 0.17.1, or use --gc-runtime=c" >&2
      return 1
    fi
  fi
  local ver; ver=$("$zigbin" version 2>/dev/null || true)
  if [ "$ver" != "0.17.1" ]; then
    echo "error: need official Zig 0.17.1 for native GC libs (got '${ver:-missing}'). Set ZIG=... or use --gc-runtime=c" >&2
    return 1
  fi
  echo "building Zig GC static libs (once; cached)…" >&2
  ( cd "$root/native/gc/zig" && "$zigbin" build gc-libs ) || return 1
}
ensure_zig_gc_libs "$@" || exit 1

# Use the opt pinned by the repo mise.toml (a mise shim outside the repo has no version set).
if [ -z "${NK_OPT:-}" ] && command -v mise >/dev/null; then
  o=$(cd "$root" && mise which opt 2>/dev/null) && export NK_OPT="$o"
fi
exec "$exe" "$@"
