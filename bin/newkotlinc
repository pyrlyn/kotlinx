#!/bin/bash
# KotlinX compiler launcher: builds compiler/build/newkotlinc.kexe on first use, then runs it.
# Usage: bin/newkotlinc Main.kt -o main && ./main
#
# Zig GC backend (default NEWKOTLIN_GC_RUNTIME=zig / --gc-runtime=zig): always runs
#   zig build gc-libs
# so collector source changes rebuild into zig-out/lib/libgc-*.a (Zig cache = incremental).
# --gc-runtime=c skips Zig. Direct newkotlinc.kexe does not build libs (see native/gc/README.md).
# --target=js runs `zig build gc-bc -Dtarget=wasm32-wasi` instead (wasm32 LLVM bitcode of the collector, default
# compact, into zig-out/wasm32-wasi/lib).
root="$(cd "$(dirname "$0")/.." && pwd)"
exe="$root/compiler/build/newkotlinc.kexe"
[ -x "$exe" ] || "$root/compiler/build.sh" >&2 || exit 1
export NEWKOTLIN_RUNTIME="${NEWKOTLIN_RUNTIME:-$root/compiler/runtime/runtime.c}"
# Vendored C GC metadata/sources (caps, kxgc.h, optional --gc-runtime=c).
export NEWKOTLIN_GC_DIR="${NEWKOTLIN_GC_DIR:-$root/native/gc/c}"
export NEWKOTLIN_GC_ZIG_LIB_DIR="${NEWKOTLIN_GC_ZIG_LIB_DIR:-$root/native/gc/zig/zig-out/lib}"
# Default collector backend is Zig (experimental). Set NEWKOTLIN_GC_RUNTIME=c for the C collectors.
export NEWKOTLIN_GC_RUNTIME="${NEWKOTLIN_GC_RUNTIME:-zig}"

# Parse CLI for --gc-runtime / --gc (env defaults apply when flags absent).
parse_gc_cli() {
  GC_RUNTIME_CLI="${NEWKOTLIN_GC_RUNTIME:-zig}"
  GC_NAME_CLI=""
  TARGET_CLI="native"
  local prev="" a
  for a in "$@"; do
    if [ "$prev" = "--gc-runtime" ]; then
      GC_RUNTIME_CLI="$a"
      prev=""
      continue
    fi
    if [ "$prev" = "--gc" ]; then
      GC_NAME_CLI="$a"
      prev=""
      continue
    fi
    if [ "$prev" = "--target" ]; then
      TARGET_CLI="$a"
      prev=""
      continue
    fi
    case "$a" in
      --gc-runtime=*) GC_RUNTIME_CLI="${a#--gc-runtime=}" ;;
      --gc-runtime) prev="--gc-runtime" ;;
      --gc=*) GC_NAME_CLI="${a#--gc=}" ;;
      --gc) prev="--gc" ;;
      --target=*) TARGET_CLI="${a#--target=}" ;;
      --target) prev="--target" ;;
      *) prev="" ;;
    esac
  done
  if [ "$GC_NAME_CLI" = "default" ]; then GC_NAME_CLI="epoch"; fi
  JS_AUTO_GC=""
  if [ "$TARGET_CLI" = "js" ] && [ -z "$GC_NAME_CLI" ] && [ -z "${NEWKOTLIN_GC:-}" ]; then JS_AUTO_GC=1; fi
  if [ "$TARGET_CLI" = "js" ] && [ -z "$GC_NAME_CLI" ]; then GC_NAME_CLI="${NEWKOTLIN_GC:-compact}"; fi
  # the jvm target translates the C collector with the program
  if [ "$TARGET_CLI" = "jvm" ]; then GC_RUNTIME_CLI=c; fi
  WASM_CLI=""
  case " $* " in *" --target=wasm "*|*" --target wasm "*) WASM_CLI=1 ;; esac
}

ensure_zig_gc_libs() {
  parse_gc_cli "$@"
  case "$GC_RUNTIME_CLI" in
    c|C) return 0 ;;
  esac
  local zigbin="${ZIG:-}"
  if [ -z "$zigbin" ]; then
    if command -v zig >/dev/null 2>&1; then zigbin=$(command -v zig); else
      echo "error: Zig 0.17.1 required to build GC libs (gc-runtime=zig). Set ZIG=/path/to/zig or install official 0.17.1, or use --gc-runtime=c" >&2
      return 1
    fi
  fi
  local ver; ver=$("$zigbin" version 2>/dev/null || true)
  if [ "$ver" != "0.17.1" ]; then
    echo "error: need official Zig 0.17.1 for native GC libs (got '${ver:-missing}'). Set ZIG=... or use --gc-runtime=c" >&2
    return 1
  fi
  # Always rebuild the selected collector and allocation mode; incompatible modes must not share an archive.
  local step=gc-libs
  if [ "$TARGET_CLI" = "js" ]; then step=gc-bc; fi
  local -a zargs=(build "$step")
  # js: wasm32 bitcode under the wasm32-wasi prefix (next to --target=wasm's archives; see WASM_ZIG_PREFIX in Main.kt).
  if [ "$TARGET_CLI" = "js" ]; then zargs+=(-Dtarget=wasm32-wasi -p zig-out/wasm32-wasi); fi
  case " $* " in *" --leak-check "*) zargs+=(-Dleakcheck=true) ;; esac
  case " $* " in *" --alloc pool"*|*" --alloc=pool "*) zargs+=(-Dpool=true) ;; esac
  case " $* " in *" --alloc malloc"*|*" --alloc=malloc "*) zargs+=(-Dplain-malloc=true) ;; esac
  if [ -n "$WASM_CLI" ]; then
    # wasm32-wasi: own install prefix (see WASM_ZIG_PREFIX in Main.kt); defaults --gc perceus, --alloc pool.
    zargs+=(-Dtarget=wasm32-wasi -p zig-out/wasm32-wasi)
    : "${GC_NAME_CLI:=perceus}"
    case " $* " in *" --alloc pool"*|*" --alloc=pool "*|*" --alloc malloc"*|*" --alloc=malloc "*) ;; *) zargs+=(-Dpool=true) ;; esac
  fi
  case "$GC_NAME_CLI" in
    epoch|perceus|incremental|compact|rc) zargs+=(-Dgc="$GC_NAME_CLI") ;;
  esac
  echo "zig build $step${GC_NAME_CLI:+ -Dgc=$GC_NAME_CLI} (Zig $ver; incremental)…" >&2
  ( cd "$root/native/gc/zig" && "$zigbin" "${zargs[@]}" ) || return 1
  # js without --gc: newkotlinc links rc instead of compact when the program has no cyclic class (JS_ACYCLIC_GC).
  if [ -n "$JS_AUTO_GC" ]; then
    local -a rargs=(); local a; for a in "${zargs[@]}"; do case "$a" in -Dgc=*) ;; *) rargs+=("$a") ;; esac; done
    ( cd "$root/native/gc/zig" && "$zigbin" "${rargs[@]}" -Dgc=rc ) || return 1
  fi
}
ensure_zig_gc_libs "$@" || exit 1
# `bin/newkotlinc --gc-libs-only [options]`: build the archives the options select, compile nothing
# (used by scripts that then run newkotlinc.kexe many times in parallel).
[ "${1:-}" = "--gc-libs-only" ] && exit 0

# Use the opt pinned by the repo mise.toml (a mise shim outside the repo has no version set). Not for js: it
# needs LLVM 22+ to read the Zig bitcode, and newkotlinc finds one itself.
if [ -z "${NK_OPT:-}" ] && [ "$TARGET_CLI" != "js" ] && command -v mise >/dev/null; then
  o=$(cd "$root" && mise which opt 2>/dev/null) && export NK_OPT="$o"
fi
exec "$exe" "$@"
